              "query": [
                {
                  "key": "q",
                  "value": "john"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get User Followers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{username}}/followers?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{username}}", "followers"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get User Following",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{username}}/following?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{username}}", "following"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Suggested Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/suggested",
              "host": ["{{baseUrl}}"],
              "path": ["users", "suggested"]
            }
          }
        }
      ]
    },
    {
      "name": "Moderation",
      "description": "Content moderation endpoints",
      "item": [
        {
          "name": "Check Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"This is a sample text to check for moderation. Please review this content.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/check",
              "host": ["{{baseUrl}}"],
              "path": ["moderation", "check"]
            }
          }
        },
        {
          "name": "Get Moderation Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/moderation/logs?page=1&limit=20&status=approved",
              "host": ["{{baseUrl}}"],
              "path": ["moderation", "logs"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "approved"
                }
              ]
            }
          }
        },
        {
          "name": "Get Moderation Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/moderation/stats?timeframe=30d",
              "host": ["{{baseUrl}}"],
              "path": ["moderation", "stats"],
              "query": [
                {
                  "key": "timeframe",
                  "value": "30d"
                }
              ]
            }
          }
        },
        {
          "name": "Appeal Moderation Decision",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tweetId\": \"{{tweetId}}\",\n  \"reason\": \"I believe this content was incorrectly flagged. It does not violate any community guidelines.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/appeal",
              "host": ["{{baseUrl}}"],
              "path": ["moderation", "appeal"]
            }
          }
        },
        {
          "name": "Report Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentId\": \"{{tweetId}}\",\n  \"reason\": \"This content contains hate speech and violates community guidelines.\",\n  \"type\": \"tweet\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/report",
              "host": ["{{baseUrl}}"],
              "path": ["moderation", "report"]
            }
          }
        },
        {
          "name": "Get Content Guidelines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/moderation/guidelines",
              "host": ["{{baseUrl}}"],
              "path": ["moderation", "guidelines"]
            }
          }
        }
      ]
    },
    {
      "name": "Health & Utility",
      "description": "Health check and utility endpoints",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Documentation",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/docs",
