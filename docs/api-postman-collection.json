    },
    {
      "name": "WebSocket Examples",
      "description": "WebSocket event examples for real-time features",
      "item": [
        {
          "name": "WebSocket Connection Example",
          "request": {
            "method": "GET",
            "url": {
              "raw": "ws://localhost:5000",
              "host": ["ws://localhost:5000"],
              "path": [""]
            },
            "description": "Connect to WebSocket server using a WebSocket client"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log('Starting request to:', pm.request.url);",
          "if (pm.collectionVariables.get('authToken')) {",
          "    console.log('Using auth token:', pm.collectionVariables.get('authToken').substring(0, 20) + '...');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test assertions",
          "pm.test('Status code is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test('Response has successful structure', function () {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "    pm.expect(jsonData).to.have.property('message');",
          "});",
          "",
          "// Log response time",
          "console.log('Response time:', pm.response.responseTime + 'ms');"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  }
}
